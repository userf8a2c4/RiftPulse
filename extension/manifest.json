{
  "manifest_version": 3,
  "name": "Worlds en vivo",
  "version": "1.0",
  "description": "Panel lateral con predicciones, copa, historial y Pick'Em de Worlds 2026.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://esports-api.lolesports.com/*",
    "https://feed.lolesports.com/*",
    "https://ddragon.leagueoflegends.com/*",
    "https://sb2frontend-altenar2.biahosted.com/*",
    "https://static.lolesports.com/*"
  ],
  "action": {
    "default_title": "Abrir Worlds en vivo"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}